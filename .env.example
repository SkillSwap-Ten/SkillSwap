# ─────────────────────────────────────────────────────
# SkillSwap v2 — local docker-compose environment
# 1. Copy this file:  cp .env.example .env
# 2. Replace EVERY  __change_me__  with a real value
# 3. NEVER commit .env  (it is gitignored)
# ─────────────────────────────────────────────────────

# ── ASP.NET Core ──
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ── MySQL ──
# Use long random passwords. For local dev you can use openssl rand -base64 24
MYSQL_ROOT_PASSWORD=__change_me_root_password__
MYSQL_DATABASE=skillswap
MYSQL_USER=skillswap_app
MYSQL_PASSWORD=__change_me_app_password__
MYSQL_PORT=3306

# ── JWT ──
# Will be consumed by Auth slice in HANDOFF-04.
# JWT_KEY must be at least 32 chars; HS256 requires 256 bits of entropy.
JWT_KEY=__change_me_at_least_32_random_characters__
JWT_ISSUER=SkillSwap
JWT_AUDIENCE=SkillSwap

# ── Seq (structured logs) ──
# Inside the compose network the API reaches Seq via http://seq (port 80).
# The host can browse the UI at http://localhost:${SEQ_UI_PORT}
SEQ_URL=http://seq
SEQ_UI_PORT=5341
